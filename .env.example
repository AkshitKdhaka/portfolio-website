# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your real values.
# Never commit your real .env file (it is gitignored).
# ─────────────────────────────────────────────────────────────

# GEMINI_API_KEY (required): Powers the AI Recruiter Companion features.
# Get it from https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# GITHUB_TOKEN (optional): Prevents GitHub public API rate limiting on the
# live stats / contribution heatmap. Classic token, no scopes needed.
# Get it from https://github.com/settings/tokens
GITHUB_TOKEN="your-github-token-here"

# RESEND_API_KEY (required for contact form): Sends contact emails to your inbox.
# Get it from https://resend.com/api-keys
RESEND_API_KEY="your-resend-api-key-here"

# CONTACT_TO_EMAIL (optional): Where contact form submissions are delivered.
# Defaults to akshitkumardhaka99@gmail.com if not set.
CONTACT_TO_EMAIL="akshitkumardhaka99@gmail.com"

# CONTACT_FROM_EMAIL (optional): The "From" address shown on contact emails.
# In production use an address on your verified domain, e.g.
#   "Portfolio Contact <contact@akshitkd.com>"
# For local testing you can omit this to use Resend's shared test sender.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
